<% content_for :title, "Unterstützer und Transparenz" %>
<% content_for :meta_description, "Transparente Darstellung externer Unterstützungen, Anschubfinanzierungen und Mittelverwendung der EEG GrünLicht Vereine." %>
<% content_for :canonical_path, unterstuetzer_path %>

<%
    # Unterstützungen je Verein. Neue Zuwendung = neuer Eintrag in :anschub.
    # :betrag wird unverändert ausgegeben, :zeitraum ist das Jahr der Zuwendung.
    vereine = [
        {
            tab_id: "bad-voeslau",
            tab_label: "EEG Grünes Licht Bad Vöslau",
            short_name: "EEG GrünLicht Bad Vöslau",
            gegruendet: "2025",
            geschaeftsjahr: "2025/2026",
            anschub: [
                {
                    name: "Die Grünen Bad Vöslau",
                    zweck: "Einmalige externe Anschubfinanzierung zur Vereinsgründung",
                    betrag: "EUR 1.000",
                    zeitraum: "2025"
                },
                {
                    name: "Familie Glockner",
                    zweck: "Interne Anschubunterstützung durch Gründungsmitglieder",
                    betrag: "EUR 500",
                    zeitraum: "2025"
                },
                {
                    name: "Familie Fabianek",
                    zweck: "Interne Anschubunterstützung durch Gründungsmitglieder",
                    betrag: "EUR 500",
                    zeitraum: "2025"
                }
            ]
        },
        {
            tab_id: "flugfeld",
            tab_label: "EEG Grünes Licht Bad Vöslau-Flugfeld",
            short_name: "EEG GrünLicht Flugfeld",
            gegruendet: "2026",
            geschaeftsjahr: "2026/2027",
            anschub: [
                {
                    name: "Die Grünen Bad Vöslau",
                    zweck: "Einmalige externe Anschubfinanzierung zur Vereinsgründung",
                    betrag: "EUR 1.000",
                    zeitraum: "2026"
                },
                {
                    name: "Familie Fabianek",
                    zweck: "Interne Anschubunterstützung durch Gründungsmitglieder",
                    betrag: "EUR 500",
                    zeitraum: "2026"
                },
                {
                    name: "Familie Sztavinovszki",
                    zweck: "Interne Anschubunterstützung durch Gründungsmitglieder",
                    betrag: "EUR 500",
                    zeitraum: "2026"
                }
            ]
        },
        {
            tab_id: "bad-voeslau-sooss",
            tab_label: "EEG Grünes Licht Bad Vöslau/Sooß",
            short_name: "EEG GrünLicht Bad Vöslau-Sooß",
            gegruendet: "2026",
            geschaeftsjahr: "2026/2027",
            anschub: [
                {
                    name: "Die Grünen Bad Vöslau",
                    zweck: "Einmalige externe Anschubfinanzierung zur Vereinsgründung",
                    betrag: "EUR 1.000",
                    zeitraum: "2026"
                },
                {
                    name: "Familie Fabianek",
                    zweck: "Interne Anschubunterstützung durch Gründungsmitglieder",
                    betrag: "EUR 500",
                    zeitraum: "2026"
                }
            ]
        }
    ]

    grundsaetze = [
        "Die Vereine sind nicht auf Gewinnerzielung ausgerichtet.",
        "Auf den innerhalb der EEG verrechneten Strompreis werden keine Aufschläge eingehoben.",
        "Die Tätigkeit in den Vereinen erfolgt ehrenamtlich.",
        "Externe Mittel werden ausschließlich für notwendige Vereinskosten verwendet."
    ]

    transparenzregeln = [
        "Alle Geldzuwendungen an die Vereine werden veröffentlicht.",
        "Auch Unterstützungen, die nicht in Geld bestehen, werden ausgewiesen — ebenso, wenn sie von Vorstandsmitgliedern kommen.",
        "Die Veröffentlichung erfolgt mit Betrag, Zeitraum, Zweck und Namen, soweit dies rechtlich und praktisch möglich ist.",
        "Keine Zuwendung begründet Einfluss-, Mitgliedschafts- oder Sonderrechte.",
        "Die Vereine bleiben politisch und religiös unabhängig."
    ]
%>

<section class="bg-white">
    <div class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900">
            Unterstützer
        </h1>

        <p class="mt-4 text-lg leading-8 text-slate-600">
            Die EEG GrünLicht ist in drei eigenständigen Vereinen organisiert. Keiner der Vereine
            verfolgt Gewinnerzielung. Diese Seite zeigt, wer den Aufbau der Energiegemeinschaften
            unterstützt hat — und wofür diese Mittel verwendet werden.
        </p>

        <div class="mt-10 space-y-12 text-slate-700">
            <section>
                <h2 class="text-xl font-semibold text-slate-900">Grundsatz der Finanzierung</h2>

                <div class="mt-5 rounded-3xl border border-slate-200 bg-slate-50 p-6">
                    <ul class="space-y-3 leading-7">
                        <% grundsaetze.each do |eintrag| %>
                            <li class="flex items-start gap-3">
                                <span class="mt-2 h-2.5 w-2.5 flex-none rounded-full bg-green-600"></span>
                                <span><%= eintrag %></span>
                            </li>
                        <% end %>
                    </ul>
                </div>
            </section>

            <section>
                <h2 class="text-xl font-semibold text-slate-900">Transparenzregeln</h2>

                <div class="mt-5 rounded-3xl border border-slate-200 bg-slate-50 p-6">
                    <ul class="space-y-3 leading-7">
                        <% transparenzregeln.each do |eintrag| %>
                            <li class="flex items-start gap-3">
                                <span class="mt-2 h-2.5 w-2.5 flex-none rounded-full bg-green-600"></span>
                                <span><%= eintrag %></span>
                            </li>
                        <% end %>
                    </ul>
                </div>
            </section>

            <section>
                <h2 class="text-xl font-semibold text-slate-900">Danke</h2>

                <p class="mt-4 leading-7 text-slate-600">
                    Eine Energiegemeinschaft entsteht nicht von selbst: Vor der ersten gelieferten
                    Kilowattstunde stehen Vereinsgründung, Registrierungen und laufender Betrieb.
                    Wir danken allen, die diesen Start möglich gemacht haben — mit Geld ebenso wie
                    mit Leistungen, die uns kostenlos zur Verfügung gestellt werden. Jede
                    Unterstützung zählt, unabhängig von ihrer Höhe. Die folgenden Karteireiter
                    zeigen die Unterstützungen des jeweiligen Vereins.
                </p>

                <div
                    class="mt-8"
                    data-controller="tabs"
                    data-tabs-active-class="border-slate-200 border-b-white bg-white text-slate-900 shadow-sm"
                    data-tabs-inactive-class="border-slate-200 bg-slate-50 text-slate-600 hover:bg-white hover:text-slate-900"
                >
                    <div class="border-b border-slate-200" role="tablist" aria-label="Vereinsauswahl">
                        <div class="flex flex-wrap items-end gap-x-2 gap-y-2">
                            <% vereine.each_with_index do |verein, index| %>
                                <button
                                    type="button"
                                    id="tab-unterstuetzer-<%= verein[:tab_id] %>"
                                    class="<%= index.zero? ? "border-slate-200 border-b-white bg-white text-slate-900 shadow-sm" : "border-slate-200 bg-slate-50 text-slate-600 hover:bg-white hover:text-slate-900" %> -mb-px rounded-t-xl border px-5 py-3 text-left text-sm font-semibold transition"
                                    role="tab"
                                    aria-selected="<%= index.zero? ? "true" : "false" %>"
                                    aria-controls="panel-unterstuetzer-<%= verein[:tab_id] %>"
                                    tabindex="<%= index.zero? ? "0" : "-1" %>"
                                    data-tabs-target="tab"
                                    data-action="click->tabs#select keydown->tabs#handleKeydown"
                                >
                                    <%= verein[:tab_label] %>
                                </button>
                            <% end %>
                        </div>
                    </div>

                    <div class="mt-10">
                        <% vereine.each_with_index do |verein, index| %>
                            <section
                                id="panel-unterstuetzer-<%= verein[:tab_id] %>"
                                class="<%= index.zero? ? "" : "hidden" %>"
                                role="tabpanel"
                                aria-labelledby="tab-unterstuetzer-<%= verein[:tab_id] %>"
                                data-tabs-target="panel"
                            >
                                <div class="flex flex-col gap-3 border-b border-slate-200 pb-6 sm:flex-row sm:items-start sm:justify-between">
                                    <div>
                                        <p class="text-sm font-medium text-green-700">Verein</p>
                                        <h3 class="mt-1 text-xl font-semibold text-slate-900">
                                            <%= verein[:short_name] %>
                                        </h3>
                                    </div>

                                    <p class="text-sm font-medium text-slate-500">
                                        gegründet <span class="text-slate-700"><%= verein[:gegruendet] %></span>
                                    </p>
                                </div>

                                <h4 class="mt-8 text-base font-semibold text-slate-900">Anschubfinanzierung</h4>

                                <div class="mt-5 grid gap-4 sm:grid-cols-2">
                                    <% verein[:anschub].each do |unterstuetzung| %>
                                        <div class="flex items-start gap-4 rounded-3xl border border-slate-200 bg-white p-5">
                                            <span class="mt-0.5 flex h-9 w-9 flex-none items-center justify-center rounded-full border border-green-100 bg-green-50">
                                                <svg class="h-4 w-4 text-green-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                                                </svg>
                                            </span>

                                            <div>
                                                <p class="font-semibold leading-snug text-slate-900"><%= unterstuetzung[:name] %></p>
                                                <p class="mt-1 text-sm leading-6 text-slate-600"><%= unterstuetzung[:zweck] %></p>
                                                <p class="mt-2 text-sm font-semibold text-slate-900">
                                                    <%= unterstuetzung[:betrag] %>
                                                    <span class="font-normal text-slate-500">· <%= unterstuetzung[:zeitraum] %></span>
                                                </p>
                                            </div>
                                        </div>
                                    <% end %>
                                </div>

                                <p class="mt-4 text-sm leading-6 text-slate-500">
                                    Aus diesen Zuwendungen entstanden keine Mitgliedschafts-, Einfluss- oder Sonderrechte.
                                </p>

                                <h4 class="mt-10 text-base font-semibold text-slate-900">Unterstützung, die kein Geld ist</h4>

                                <div class="mt-5 flex items-start gap-4 rounded-3xl border border-green-100 bg-green-50 p-6">
                                    <span class="mt-0.5 flex h-10 w-10 flex-none items-center justify-center rounded-full border border-green-100 bg-white">
                                        <svg class="h-5 w-5 text-green-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75" />
                                        </svg>
                                    </span>

                                    <div>
                                        <p class="font-semibold text-slate-900">Christoph Fabianek</p>
                                        <p class="mt-1.5 leading-7 text-slate-700">
                                            stellt dem Verein über sein Unternehmen kostenfrei den
                                            <strong>digitalen Vereinssitz</strong> zur Verfügung — den Ort, an dem die
                                            Website zu Hause ist, die Vereins-E-Mail-Adressen liegen, Unterlagen
                                            gemeinsam abgelegt werden und die Mitgliederverwaltung geführt wird.
                                            Was ein Verein sonst Monat für Monat zukaufen müsste, kostet uns dadurch nichts.
                                        </p>
                                        <span class="mt-3 inline-block rounded-full border border-green-100 bg-white px-2.5 py-0.5 text-xs font-semibold text-green-800">
                                            kostenfrei · seit der Gründung
                                        </span>
                                    </div>
                                </div>

                                <p class="mt-4 text-sm leading-6 text-slate-500">
                                    Transparenzhinweis: Christoph Fabianek ist zugleich Obmann des Vereins. Die Leistung
                                    wird unentgeltlich erbracht — es wird nichts verrechnet, es fließt kein Geld und es
                                    entstehen keine Ansprüche gegenüber dem Verein.
                                </p>

                                <h4 class="mt-10 text-base font-semibold text-slate-900">Laufende Unterstützungen und Mittelverwendung</h4>

                                <div class="mt-5 overflow-x-auto rounded-3xl border border-slate-200">
                                    <table class="min-w-[620px] md:min-w-full table-auto divide-y divide-slate-200 bg-white">
                                        <colgroup>
                                            <col class="w-[22%]">
                                            <col class="w-[26%]">
                                            <col class="w-[26%]">
                                            <col class="w-[26%]">
                                        </colgroup>
                                        <thead class="bg-slate-50">
                                            <tr>
                                                <th class="px-4 py-3 text-left text-sm font-semibold text-slate-900">Geschäftsjahr</th>
                                                <th class="px-4 py-3 text-left text-sm font-semibold text-slate-900">Erhaltene Unterstützungen</th>
                                                <th class="px-4 py-3 text-left text-sm font-semibold text-slate-900">Laufende Kosten</th>
                                                <th class="px-4 py-3 text-left text-sm font-semibold text-slate-900">Übertrag ins Folgejahr</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-200 bg-white">
                                            <tr>
                                                <td class="px-4 py-4 align-top text-sm text-slate-700 whitespace-nowrap"><%= verein[:geschaeftsjahr] %></td>
                                                <td class="px-4 py-4 align-top text-sm text-slate-500">wird laufend ergänzt</td>
                                                <td class="px-4 py-4 align-top text-sm text-slate-500">wird laufend ergänzt</td>
                                                <td class="px-4 py-4 align-top text-sm text-slate-500">wird nach Jahresabschluss ausgewiesen</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        <% end %>
                    </div>
                </div>
            </section>
        </div>

        <p class="mt-12 border-t border-slate-200 pt-5 text-sm leading-6 text-slate-500">
            Hinweis: Die Darstellung wird fortlaufend aktualisiert. Soweit rechtlich oder praktisch
            erforderlich, können einzelne Angaben zusammengefasst oder anonymisiert werden.
        </p>
    </div>
</section>
