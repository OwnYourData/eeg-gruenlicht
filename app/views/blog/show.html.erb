<% content_for :title, @post.title %>
<% content_for :meta_description, @post.summary %>
<% content_for :canonical_path, blog_post_path(@post) %>
<% content_for :og_type, "article" %>
<% if @post.draft? %>
    <% content_for :robots, "noindex,nofollow" %>
<% elsif @post.unlisted? || !BlogPost.listed? %>
    <% content_for :robots, "noindex,follow" %>
<% end %>

<% content_for :head do %>
    <meta property="article:published_time" content="<%= @post.date.iso8601 %>">
    <meta property="article:modified_time" content="<%= @post.last_modified.iso8601 %>">
    <% if @post.category %>
        <meta property="article:section" content="<%= @post.category %>">
    <% end %>
<% end %>

<% content_for :structured_data do %>
  <script type="application/ld+json">
    <%= raw JSON.pretty_generate({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": @post.title,
      "description": @post.summary,
      "url": canonical_url,
      "mainEntityOfPage": canonical_url,
      "datePublished": @post.date.iso8601,
      "dateModified": @post.last_modified.iso8601,
      "inLanguage": "de-AT",
      "author": { "@type": "Person", "name": @post.author },
      "publisher": { "@type": "Organization", "name": site_name, "url": site_url, "logo": seo_image_url },
      "image": seo_image_url
    }) %>
  </script>
<% end %>

<article class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
    <nav aria-label="Brotkrumen" class="text-sm text-slate-500">
        <%= link_to "Start", root_path, class: "hover:text-green-700" %>
        <span class="mx-2">›</span>
        <%= link_to "Blog", blog_path, class: "hover:text-green-700" %>
    </nav>

    <% if @post.draft? %>
        <div class="mt-6 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            <strong>Entwurf</strong> — dieser Beitrag ist nur in der Vorschau sichtbar und wird nicht veröffentlicht,
            solange im Frontmatter <code>draft: true</code> steht.
        </div>
    <% end %>

    <header class="mt-8">
        <% if @post.category %>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-700"><%= @post.category %></p>
        <% end %>

        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl lg:text-[2.6rem] lg:leading-tight">
            <%= @post.title %>
        </h1>

        <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-500">
            <span><%= @post.author %></span>
            <span aria-hidden="true">·</span>
            <time datetime="<%= @post.date.iso8601 %>"><%= blog_date(@post.date) %></time>
            <% if @post.updated %>
                <span aria-hidden="true">·</span>
                <span>aktualisiert am <time datetime="<%= @post.updated.iso8601 %>"><%= blog_date(@post.updated) %></time></span>
            <% end %>
            <span aria-hidden="true">·</span>
            <span><%= blog_reading_time(@post) %></span>
        </p>

        <% if @post.summary.present? %>
            <p class="mt-8 border-l-4 border-green-600 pl-5 text-lg leading-8 text-slate-700">
                <%= @post.summary %>
            </p>
        <% end %>
    </header>

    <div class="blog-prose mt-10">
        <%= @post.html %>
    </div>

    <aside class="mt-14 rounded-3xl border border-green-200 bg-green-50 p-7 sm:p-9">
        <h2 class="text-xl font-semibold text-slate-900">Mitmachen in der EEG Grünes Licht</h2>
        <p class="mt-3 leading-7 text-slate-700">
            Ob mit eigener PV-Anlage oder ohne: Mitglieder beziehen bzw. liefern Strom aus der Region zu 11 ct/kWh USt-frei,
            profitieren von reduzierten Netzentgelten und zahlen keine Mitgliedsgebühr.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
            <%= link_to "Jetzt mitmachen", "/#beitritt",
                class: "inline-flex items-center rounded-xl bg-green-700 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-green-800" %>
            <%= link_to "Frage stellen", "/#kontakt",
                class: "inline-flex items-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-medium text-slate-900 transition hover:bg-slate-50" %>
        </div>
    </aside>
</article>

<% if @more_posts.any? %>
    <section class="border-t border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-6xl px-6 py-14">
            <div class="flex items-end justify-between gap-4">
                <h2 class="text-2xl font-semibold tracking-tight text-slate-900">Weitere Beiträge</h2>
                <%= link_to "Alle Beiträge →", blog_path, class: "text-sm font-medium text-green-700 hover:text-green-800" %>
            </div>
            <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                <% @more_posts.each do |post| %>
                    <%= render "blog/post_card", post: post %>
                <% end %>
            </div>
        </div>
    </section>
<% end %>
